unit Bitmaps;

interface

uses
  Graphics, Geometry, StrUtils, Classes;

type

  TBitmapEntryKind = (bek_None, bek_BMP, bek_PNG, bek_JPEG);

  TBitmapEntry = class(TObject)
  protected
    fImageLink: string;
    fBitmap: Graphics.TBitmap;
    fKind: TBitmapEntryKind;
    fParentFileName: string;
    fImageFiles: TStringList;
    function MakeImageLocal(
      const Link, ParentFileName: string): string;
    procedure SetImageKind(const Link: string);
    procedure SetImageLink(const Link: string);
  public
    constructor Create(const AImageLink: string;
      const ParentFileName: string);
    destructor Destroy; override;
    procedure RefreshParentFileName(
      const NewFileName: string);
    procedure RebaseParentFileName(const NewFileName: string);
    procedure RestoreLink(const Link, ParentFileName: string);
    procedure AdoptImageLink(const Link: string);
    procedure RebindParentFileName(const NewFileName: string);
    function GetFullLink: string;
    function GetOnlyName: string;
    function ImageFileExists(const FileName: string): Boolean;
    function CopyImage(
      const FileName1, FileName2: string): Boolean;
    function RequirePNGJPEG(const OutDir: string): Boolean;
    function RequireEPS(const OutDir: string): Boolean;
    function GetIncludeGraphics(const W, H: TRealType;
      const KeepAspectRatio: Boolean;
      const IncludePath: string): string;
    property Kind: TBitmapEntryKind read fKind;
    property ImageLink: string read fImageLink;
    property ParentFileName: string read fParentFileName;
    property Bitmap: Graphics.TBitmap read fBitmap;
  end;

function BitmapToEps(const BitmapFileName: string;
  const OutFileName: string): Boolean;
function Bitmap2EpsAvailable: Boolean;
var
{$IFDEF MSWINDOWS}Bitmap2EpsPath: string = 'sam2p.exe';
{$ELSE}Bitmap2EpsPath: string = 'sam2p'; {$ENDIF}

{$I tpx.inc}

implementation
uses
  SysBasic,
  DocumentFormats,
{$IFDEF FPC}
  IntfGraphics, FPImage,
{$ENDIF}
{$IFNDEF FPC}
   Imaging.pngimage, Imaging.jpeg,
{$ENDIF}
  SysUtils;

function BitmapPathFromString(const FileName: string): TDocumentPath;
{$IFDEF FPC}
var Bytes: RawByteString;
{$ENDIF}
begin
{$IFDEF FPC}
  { Legacy TpX paths are UTF-8 bytes even when the AnsiString tag is ACP. }
  SetLength(Bytes, Length(FileName));
  if Length(FileName) > 0 then
    Move(FileName[1], Bytes[1], Length(FileName));
  SetCodePage(Bytes, 65001, False);
  Result := TDocumentPath(Bytes);
{$ELSE}
  Result := FileName;
{$ENDIF}
end;

function BitmapPathAsString(const FileName: TDocumentPath): string;
{$IFDEF FPC}
var Bytes: RawByteString;
{$ENDIF}
begin
{$IFDEF FPC}
  SetLength(Bytes, Length(FileName));
  if Length(FileName) > 0 then
    Move(FileName[1], Bytes[1], Length(FileName));
  SetCodePage(Bytes, DefaultSystemCodePage, False);
  Result := Bytes;
{$ELSE}
  Result := FileName;
{$ENDIF}
end;

function FixSam2pEps(const EpsFileName: TDocumentPath): Boolean;
// Remove colon from "%%BeginData:" in EPS file generated by sam2p v.0.43 for Windows
var
  Snapshot: TDocumentSnapshot;
  Bytes: RawByteString;
  StageDirectory, TemporaryFile: TDocumentPath;
  LineStart, LineEnd, LineNumber: Integer;
  Changed: Boolean;
begin
  Result := False;
  StageDirectory := '';
  TemporaryFile := '';
  try
    Snapshot := ReadDocumentSnapshot(EpsFileName);
    Bytes := Snapshot.SourceBytes;
    Changed := False;
    LineStart := 1;
    LineNumber := 0;
    while (LineStart <= Length(Bytes)) and (LineNumber < 50) do
    begin
      LineEnd := LineStart;
      while (LineEnd <= Length(Bytes)) and (Bytes[LineEnd] <> #10) do
        Inc(LineEnd);
      if (LineEnd - LineStart >= 12) and
        (Copy(Bytes, LineStart, 12) = '%%BeginData:') then
      begin
        Delete(Bytes, LineStart + 11, 1);
        Dec(LineEnd);
        Changed := True;
      end;
      Inc(LineNumber);
      LineStart := LineEnd + 1;
    end;
    if not Changed then Exit(True);
    StageDirectory := CreateDocumentStagingDirectory(
      DocumentPathDirectory(EpsFileName));
    if StageDirectory = '' then Exit;
    TemporaryFile := IncludeTrailingPathDelimiter(StageDirectory) +
      'fixed.eps';
    WriteDocumentStagingFile(TemporaryFile, Bytes);
    Result := ReplaceDocumentFile(TemporaryFile, EpsFileName);
  finally
    if TemporaryFile <> '' then DeleteDocumentFile(TemporaryFile);
    if StageDirectory <> '' then RemoveDocumentStagingDirectory(StageDirectory);
  end;
end;

{$IFDEF FPC}{$IFDEF MSWINDOWS}
function BitmapToEpsInPrivateDirectory(const BitmapFileName,
  OutFileName: string): Boolean;
var
  StageDirectory, InputFile, OutputFile: TDocumentPath;
  SourcePath, DestinationPath: TDocumentPath;
  Snapshot: TDocumentSnapshot;
  ToolPath, Command, InputExtension: string;
  ExtensionIndex: Integer;
begin
  Result := False;
  StageDirectory := '';
  InputFile := '';
  OutputFile := '';
  SourcePath := BitmapPathFromString(BitmapFileName);
  DestinationPath := BitmapPathFromString(OutFileName);
  try
    try
      if DocumentFileIsSymbolicLink(DestinationPath) then Exit;
      if DocumentFileExists(DestinationPath) and
        not DeleteDocumentFile(DestinationPath) then Exit;
      StageDirectory := CreateDocumentStagingDirectory(
        DocumentPathDirectory(DestinationPath));
      if StageDirectory = '' then Exit;

      { sam2p uses narrow fopen. Keep its arguments ASCII and relative, while
        ProcessUnicode supplies the Unicode working directory. }
      InputExtension := ExtractFileExt(BitmapFileName);
      if (Length(InputExtension) < 2) or (Length(InputExtension) > 16) then
        InputExtension := ''
      else
        for ExtensionIndex := 2 to Length(InputExtension) do
          if not (InputExtension[ExtensionIndex] in
            ['a'..'z', 'A'..'Z', '0'..'9']) then
          begin
            InputExtension := '';
            Break;
          end;
      InputExtension := LowerCase(InputExtension);
      InputFile := IncludeTrailingPathDelimiter(StageDirectory) +
        'input' + InputExtension;
      OutputFile := IncludeTrailingPathDelimiter(StageDirectory) + 'output.eps';
      Snapshot := ReadDocumentSnapshot(SourcePath);
      WriteDocumentStagingFile(InputFile, Snapshot.SourceBytes);

      ToolPath := PrepareFilePath(Bitmap2EpsPath);
      if Pos('bmeps', LowerCase(Bitmap2EpsPath)) > 0 then
        ToolPath := ToolPath + ' -c';
      Command := Format('%s "%s" "%s"', [ToolPath,
        ExtractFileName(string(InputFile)), ExtractFileName(string(OutputFile))]);
      if not FileExec(Command, '', '', BitmapPathAsString(StageDirectory),
        True, True) or
        not DocumentFileExists(OutputFile) then Exit;
      if (Pos('sam2p', LowerCase(Bitmap2EpsPath)) > 0) and
        (LowerCase(ExtractFileExt(OutFileName)) = '.eps') and
        not FixSam2pEps(OutputFile) then Exit;
      Result := ReplaceDocumentFile(OutputFile, DestinationPath);
    except
      Result := False;
    end;
  finally
    if InputFile <> '' then DeleteDocumentFile(InputFile);
    if OutputFile <> '' then DeleteDocumentFile(OutputFile);
    if StageDirectory <> '' then RemoveDocumentStagingDirectory(StageDirectory);
  end;
end;
{$ENDIF}{$ENDIF}

function BitmapToEpsLegacy(const BitmapFileName,
  OutFileName: string): Boolean;
var TmpPath: string;
begin
  TryDeleteFile(OutFileName);
  TmpPath := PrepareFilePath(Bitmap2EpsPath);
  if Pos('bmeps', LowerCase(TmpPath)) > 0 then
    TmpPath := TmpPath + ' -c';
  try
    Result := FileExec(Format('%s "%s" "%s"',
      [TmpPath, BitmapFileName, OutFileName]), '', '',
      '', True, True);
    if Result then
      Result := FileExists(OutFileName);
  finally
  end;
  if Result and (Pos('sam2p', LowerCase(Bitmap2EpsPath)) > 0) and
    (LowerCase(ExtractFileExt(OutFileName)) = '.eps') then
    Result := FixSam2pEps(BitmapPathFromString(OutFileName));
end;

function Bitmap2EpsAvailable: Boolean;
var ToolPath: string; I: Integer;
begin
  // Probe like CheckFilePath, but without its error dialogs.
  ToolPath := Trim(Bitmap2EpsPath);
  if (ToolPath <> '') and not (ToolPath[1] in ['"', '''']) then
  begin
    I := Pos(' ', ToolPath);
    if I > 0 then ToolPath := Copy(ToolPath, 1, I - 1);
  end;
  if (ToolPath <> '') and (ToolPath[1] in ['"', '''']) then
    ToolPath := AnsiDequotedStr(ToolPath, ToolPath[1]);
  if (ToolPath <> '') and (ExtractFilePath(ToolPath) = '') then
    ToolPath := FileSearch(ToolPath, '.' + PathSeparator +
      ExtractFilePath(ParamStr(0)) + PathSeparator +
      GetEnvironmentVariable('PATH'));
  Result := (ToolPath <> '') and FileExists(ToolPath);
end;

function BitmapToEps(const BitmapFileName: string;
  const OutFileName: string): Boolean;
begin
  Result := False;
  if not CheckFilePath(Bitmap2EpsPath, 'Bitmap2Eps') then Exit;
{$IFDEF FPC}{$IFDEF MSWINDOWS}
  Result := BitmapToEpsInPrivateDirectory(BitmapFileName, OutFileName);
{$ELSE}
  Result := BitmapToEpsLegacy(BitmapFileName, OutFileName);
{$ENDIF}{$ELSE}
  Result := BitmapToEpsLegacy(BitmapFileName, OutFileName);
{$ENDIF}
  if not Result then
  begin
    MessageBoxError('Conversion of bitmap to EPS failed: ' + BitmapFileName);
    Exit;
  end;
end;

function StoreBitmapToPNG(BMP: Graphics.TBitmap;
  const FileName: string): Boolean;
var
  {$IFDEF FPC}
  PNG: TPortableNetworkGraphic;
  {$ELSE}
  PNG: TPNGObject;
  {$ENDIF}
begin
  Result := False;
  {$IFDEF FPC}
  PNG := TPortableNetworkGraphic.Create;
  {$ELSE}
  PNG := TPNGObject.Create;
  {$ENDIF}
  try
    PNG.Assign(BMP);
    PNG.SaveToFile(FileName);
    Result := True;
  finally
    PNG.Free;
  end;
end;

function LoadPng(BMP: Graphics.TBitmap; const FileName: string):
  Boolean;
var
  {$IFDEF FPC}
  PNG: TPortableNetworkGraphic;
  {$ELSE}
  PNG: TPNGObject;
  {$ENDIF}
begin
  Result := False;
  if not FileExists(FileName) then Exit;
  {$IFDEF FPC}
  PNG := TPortableNetworkGraphic.Create;
  {$ELSE}
  PNG := TPNGObject.Create;
  {$ENDIF}
  try
    PNG.LoadFromFile(FileName);
    BMP.Assign(PNG);
    Result := True;
  finally
    PNG.Free;
  end;
end;

function LoadJpeg(BMP: Graphics.TBitmap; const FileName: string):
  Boolean;
var
  JPG: TJPEGImage;
begin
  Result := False;
  if not FileExists(FileName) then Exit;
  JPG := TJPEGImage.Create;
  try
    JPG.LoadFromFile(FileName);
    BMP.Assign(JPG);
    Result := True;
  finally
    JPG.Free;
  end;
end;

{ --================ TBitmapEntry ==================-- }

constructor TBitmapEntry.Create(const AImageLink: string;
  const ParentFileName: string);
begin
  inherited Create;
  fParentFileName := ParentFileName;
  fBitmap := Graphics.TBitmap.Create;
  fImageFiles := TStringList.Create;
  fImageFiles.Sorted := True;
  fImageFiles.Duplicates := dupIgnore;
  SetImageLink(AImageLink);
end;

destructor TBitmapEntry.Destroy;
begin
  fBitmap.Free;
  fImageFiles.Free;
  inherited Destroy;
end;

function IsRelativeImageLink(const Link: string): Boolean;
begin
  Result := (Link <> '') and (ExtractFileDrive(Link) = '') and
    (Copy(Link, 1, 1) <> PathDelim) and (Copy(Link, 1, 1) <> '/');
end;

{$IF DEFINED(UNIX) AND NOT DEFINED(WASI)}
function c_realpath(Path, Resolved: PChar): PChar; cdecl;
  external 'c' name 'realpath';
{$ENDIF}

function CanonicalFileName(const FileName: string): string;
{$IF DEFINED(UNIX) AND NOT DEFINED(WASI)}
var
  Buffer: array[0..4095] of Char;
{$ENDIF}
begin
  Result := ExpandFileName(FileName);
{$IF DEFINED(UNIX) AND NOT DEFINED(WASI)}
  // Resolve symlinked folders (macOS /var -> /private/var) so both sides
  // of a relative link share their real ancestors.
  if c_realpath(PChar(ExtractFileDir(Result)), @Buffer[0]) <> nil then
    Result := IncludeTrailingPathDelimiter(StrPas(@Buffer[0])) +
      ExtractFileName(Result);
{$ENDIF}
end;

function RelativeImageLink(const FullLink, ParentFileName: string): string;
begin
  if ParentFileName = '' then Exit(FullLink);
  Result := ExtractRelativePath(CanonicalFileName(ParentFileName),
    CanonicalFileName(FullLink));
{$IFDEF MSWINDOWS}
  // Stored links use '/' so drawings and TeX output stay portable.
  if IsRelativeImageLink(Result) then
    Result := StringReplace(Result, '\', '/', [rfReplaceAll]);
{$ENDIF}
end;

function TBitmapEntry.MakeImageLocal(
  const Link, ParentFileName: string): string;
{$IFDEF CPUWASM32}
var
  Dir: string;
{$ENDIF}
begin
{$IFNDEF CPUWASM32}
  // Link the image where it is; a relative link keeps the project portable.
  Result := RelativeImageLink(Link, ParentFileName);
{$ELSE}
  Result := Link;
  Dir := ExtractFilePath(ParentFileName);
  if ParentFileName = '' then
  else if Pos(Dir, Result) = 1 then
    System.Delete(Result, 1, Length(Dir))
  else
  begin
    Dir := Dir + 'bitmaps' + PathDelim;
    if not DirectoryExists(Dir) then CreateDir(Dir);
    CopyImage(Link, Dir + ExtractFileName(Result));
    Result := 'bitmaps' + PathDelim + ExtractFileName(Result);
  end;
{$ENDIF}
end;

procedure TBitmapEntry.SetImageKind(const Link: string);
var
  Ext: string;
begin
  Ext := LowerCase(ExtractFileExt(fImageLink));
  if Ext = '.bmp' then fKind := bek_BMP
  else if Ext = '.png' then fKind := bek_PNG
  else if (Ext = '.jpg') or (Ext = '.jpeg') then fKind := bek_JPEG
  else fKind := bek_None;
  if Link <> '' then
  begin
    case fKind of
      bek_BMP:
        begin
          if not FileExists(Link) then fKind := bek_None else
          try
            fBitmap.LoadFromFile(Link);
          except
            fKind := bek_None;
          end;
        end;
      bek_PNG:
        if not LoadPng(fBitmap, Link) then fKind := bek_None;
      bek_JPEG:
        if not LoadJpeg(fBitmap, Link) then fKind := bek_None;
    end;
    if fKind <> bek_None then fImageFiles.Add(Link);
  end;
end;

procedure TBitmapEntry.SetImageLink(const Link: string);
begin
  if Link = '' then
  begin
    fImageLink := '';
    Exit;
  end;
  fImageLink := MakeImageLocal(Link, fParentFileName);
  SetImageKind(Link);
end;

function TBitmapEntry.GetFullLink: string;
begin
  if (ExtractFileDrive(fImageLink) = '') and
    (Copy(fImageLink, 1, 1) <> PathDelim) then
    Result := ExtractFilePath(fParentFileName) + fImageLink
  else Result := fImageLink;
end;

function TBitmapEntry.GetOnlyName: string;
begin
  Result := ChangeFileExt(ExtractFileName(fImageLink), '');
end;

function TBitmapEntry.ImageFileExists(
  const FileName: string): Boolean;
begin
  Result := (fImageFiles.IndexOf(FileName) >= 0) and
    FileExists(FileName);
end;

procedure TBitmapEntry.RefreshParentFileName(
  const NewFileName: string);
var
  NewDir, NewLink: string;
begin
  if (ExtractFileDrive(fImageLink) <> '') or
    (Copy(fImageLink, 1, 1) = PathDelim) then
  begin
    fImageLink := MakeImageLocal(fImageLink, NewFileName);
    SetImageKind('');
    fParentFileName := NewFileName;
    Exit;
  end;
  NewLink := ExtractFilePath(NewFileName) + fImageLink;
  NewDir := ExtractFilePath(NewLink);
  if (NewDir <> '') and not DirectoryExists(NewDir)
    then ForceDirectories(NewDir);
  if not ImageFileExists(NewLink) then
    CopyImage(GetFullLink, NewLink);
  SetImageKind('');
  fParentFileName := NewFileName;
end;

procedure TBitmapEntry.RebaseParentFileName(const NewFileName: string);
begin
  // Keep pointing at the same file, relative to the new drawing location.
  if NewFileName = '' then fImageLink := ExpandFileName(GetFullLink)
  else if not IsRelativeImageLink(fImageLink) or not SameExistingFile(
    ExtractFilePath(NewFileName) + fImageLink, GetFullLink) then
    fImageLink := RelativeImageLink(GetFullLink, NewFileName);
  // Otherwise the stored link still resolves and keeps its spelling.
  fParentFileName := NewFileName;
end;

procedure TBitmapEntry.RestoreLink(const Link, ParentFileName: string);
begin
  fImageLink := Link;
  fParentFileName := ParentFileName;
end;

procedure TBitmapEntry.AdoptImageLink(const Link: string);
begin
  fImageLink := Link;
  SetImageKind(Link);
end;

procedure TBitmapEntry.RebindParentFileName(const NewFileName: string);
begin
  fParentFileName := NewFileName;
end;

function TBitmapEntry.CopyImage(
  const FileName1, FileName2: string): Boolean;
begin
  Result := CopyFile(FileName1, FileName2);
  if Result then fImageFiles.Add(FileName2);
end;

function TBitmapEntry.RequirePNGJPEG(
  const OutDir: string): Boolean;
var
  OutFileName: string;
begin
  Result := True;
  if fKind = bek_None then Exit;
  if fKind = bek_BMP then
    OutFileName := OutDir + GetOnlyName + '.png'
  else
    OutFileName := OutDir + ExtractFileName(fImageLink);
  if ImageFileExists(OutFileName) then Exit;
  if fKind = bek_BMP then
  begin
    Result := StoreBitmapToPNG(fBitmap, OutFileName);
    if Result then fImageFiles.Add(OutFileName);
    Exit;
  end;
  Result := CopyImage(GetFullLink, OutFileName);
end;

{$IFDEF FPC}
function StoreBitmapToEPS(BMP: Graphics.TBitmap;
  const FileName: string): Boolean;
const
  HexDigits = '0123456789ABCDEF';
var
  Image: TLazIntfImage;
  F: TextFile;
  Row: string;
  X, Y, Offset: Integer;
  Color: TFPColor;
  procedure AddChannel(Value: Word);
  var
    Channel: LongWord;
  begin
    // PostScript has no alpha channel: flatten transparent pixels onto white.
    Channel := (65535 - Color.Alpha +
      LongWord(Value) * Color.Alpha div 65535) shr 8;
    Row[Offset] := HexDigits[1 + (Channel shr 4)];
    Row[Offset + 1] := HexDigits[1 + (Channel and 15)];
    Inc(Offset, 2);
  end;
begin
  Result := False;
  if (BMP.Width <= 0) or (BMP.Height <= 0) then Exit;
  Image := BMP.CreateIntfImage;
  try
    SetLength(Row, Image.Width * 6);
    AssignFile(F, FileName);
    Rewrite(F);
    try
      WriteLn(F, '%!PS-Adobe-3.0 EPSF-3.0');
      WriteLn(F, '%%BoundingBox: 0 0 ', Image.Width, ' ', Image.Height);
      WriteLn(F, '%%EndComments');
      WriteLn(F, 'gsave');
      WriteLn(F, Image.Width, ' ', Image.Height, ' scale');
      WriteLn(F, '/row ', Image.Width * 3, ' string def');
      WriteLn(F, Image.Width, ' ', Image.Height, ' 8');
      WriteLn(F, '[', Image.Width, ' 0 0 -', Image.Height, ' 0 ', Image.Height, ']');
      WriteLn(F, '{currentfile row readhexstring pop} false 3 colorimage');
      for Y := 0 to Image.Height - 1 do
      begin
        Offset := 1;
        for X := 0 to Image.Width - 1 do
        begin
          Color := Image.Colors[X, Y];
          AddChannel(Color.Red);
          AddChannel(Color.Green);
          AddChannel(Color.Blue);
        end;
        WriteLn(F, Row);
      end;
      WriteLn(F, 'grestore');
      WriteLn(F, '%%EOF');
      Result := True;
    finally
      CloseFile(F);
    end;
  finally
    Image.Free;
  end;
end;
{$ENDIF}

function TBitmapEntry.RequireEPS(
  const OutDir: string): Boolean;
var
  BitmapFileName, OutFileName: string;
begin
  Result := True;
  if fKind = bek_None then Exit;
  OutFileName := OutDir + GetOnlyName + '.eps';
  if (Pos(GetTempDir, OutDir) <> 1)
    and ImageFileExists(OutFileName) then Exit;
{$IFDEF FPC}
  // The pixels are already decoded. Without a configured converter, write
  // them as a plain EPS image instead of failing; the browser has none.
  if {$IFNDEF WASI}not Bitmap2EpsAvailable{$ELSE}True{$ENDIF} then
  begin
    Result := StoreBitmapToEPS(fBitmap, OutFileName);
    if Result then fImageFiles.Add(OutFileName);
    Exit;
  end;
{$ENDIF}
  if (fKind = bek_JPEG) or
    ((fKind = bek_BMP)
    and (Pos('sam2p', LowerCase(Bitmap2EpsPath)) > 0))
    or
    ((fKind = bek_PNG)
    and (Pos('bmeps', LowerCase(Bitmap2EpsPath)) > 0))
    then BitmapFileName := GetFullLink
  else if fKind = bek_PNG then
  begin
    BitmapFileName := GetTempDir + '(Bitmap2Eps)bmp.bmp';
    try
      fBitmap.SaveToFile(BitmapFileName);
    except
      Result := False;
      Exit;
    end;
  end
  else if fKind = bek_BMP then
  begin
    BitmapFileName := GetTempDir + '(Bitmap2Eps)png.png';
    try
      Result := StoreBitmapToPNG(fBitmap, BitmapFileName);
    except
      Result := False;
      Exit;
    end;
  end;
  Result := BitmapToEps(BitmapFileName, OutFileName);
  if Result then fImageFiles.Add(OutFileName);
  if Pos(GetTempDir + '(Bitmap2Eps)', BitmapFileName) = 1
    then TryDeleteFile(BitmapFileName);
end;

function TBitmapEntry.GetIncludeGraphics(const W, H: TRealType;
  const KeepAspectRatio: Boolean;
  const IncludePath: string): string;
begin
  Result := AnsiReplaceStr(ChangeFileExt(fImageLink, ''),
    '\', '/');
  if (ExtractFileDrive(fImageLink) = '') and
    (Copy(fImageLink, 1, 1) <> PathDelim) then
    Result := IncludePath + Result;
  if KeepAspectRatio then
    Result := Format(
      '\includegraphics[width=%.2fmm]{%s}', [W, Result])
  else
    Result := Format(
      '\includegraphics[width=%.2fmm, height=%.2fmm]{%s}',
      [W, H, Result]);
end;

end.

