From 981660ebd79833a30c67ac08024b8b6812a354a8 Mon Sep 17 00:00:00 2001
From: Christopher Albert <albert@tugraz.at>
Date: Sun, 11 Oct 2026 02:03:12 +0200
Subject: [PATCH] cocoa: report composition in field editor

---
 lcl/interfaces/cocoa/cocoatextedits.pas | 175 +++++++++++++++++++++++-
 1 file changed, 173 insertions(+), 2 deletions(-)

diff --git a/lcl/interfaces/cocoa/cocoatextedits.pas b/lcl/interfaces/cocoa/cocoatextedits.pas
index be6e5a9b3b..e2c3e9f0ba 100644
--- a/lcl/interfaces/cocoa/cocoatextedits.pas
+++ b/lcl/interfaces/cocoa/cocoatextedits.pas
@@ -168,6 +168,10 @@ type
     // when switching "editable" (readonly) mode of NSTextField
     // see TCocoaWSCustomEdit.SetReadOnly
     goingReadOnly: Boolean;
+    FCompositionGeneration: NSUInteger;
+    FCompositionActive: Boolean;
+    FCompositionEndToken: TCocoaTextViewCompositionEndToken;
+    procedure dealloc; override;
     function lclGetCallback: ICommonCallback; override;
     function becomeFirstResponder: LCLObjCBoolean; override;
     procedure setDelegate(adelegate: NSTextDelegateProtocol); override;
@@ -176,6 +180,14 @@ type
     procedure cut(sender: id); override;
     procedure paste(sender: id); override;
     procedure insertNewline(sender: id); override;
+    procedure insertText_replacementRange(aString: id; replacementRange: NSRange); override;
+    procedure setMarkedText_selectedRange_replacementRange(aString: id; newRange: NSRange; replacementRange: NSRange); override;
+    procedure unmarkText; override;
+    procedure finishCompositionEnd(aToken: TCocoaTextViewCompositionEndToken); message 'finishCompositionEnd:';
+    procedure sendCompositionMessage(const flags: WPARAM; const text: NSString); message 'lclSendCompositionMessage::';
+    procedure queueCompositionEnd; message 'lclQueueCompositionEnd';
+    procedure cancelCompositionEnd; message 'lclCancelCompositionEnd';
+    procedure endComposition(const committedText: NSString; const isCommit: Boolean); message 'lclEndComposition::';
     // mouse
     procedure mouseDown(event: NSEvent); override;
     procedure mouseUp(event: NSEvent); override;
@@ -425,6 +437,158 @@ begin
   else Result := nil;
 end;
 
+procedure TCocoaFieldEditor.dealloc;
+begin
+  cancelCompositionEnd;
+  inherited dealloc;
+end;
+
+procedure TCocoaFieldEditor.insertText_replacementRange(aString: id;
+  replacementRange: NSRange);
+var
+  wasComposing: Boolean;
+begin
+  retain;
+  try
+    wasComposing := FCompositionActive or
+      NSTextInputClientProtocol(Self).hasMarkedText;
+    inherited insertText_replacementRange(aString, replacementRange);
+    if wasComposing and not NSTextInputClientProtocol(Self).hasMarkedText then
+      endComposition(TCocoaStringUtil.getNSStringObject(aString), True);
+  finally
+    release;
+  end;
+end;
+
+procedure TCocoaFieldEditor.setMarkedText_selectedRange_replacementRange(
+  aString: id; newRange: NSRange; replacementRange: NSRange);
+var
+  wasMarked, isMarked: Boolean;
+begin
+  retain;
+  try
+    wasMarked := NSTextInputClientProtocol(Self).hasMarkedText;
+    inherited setMarkedText_selectedRange_replacementRange(
+      aString, newRange, replacementRange);
+    if not Assigned(lclGetCallback) then
+    begin
+      cancelCompositionEnd;
+      FCompositionActive := False;
+      Inc(FCompositionGeneration);
+      Exit;
+    end;
+    isMarked := NSTextInputClientProtocol(Self).hasMarkedText;
+    if isMarked then
+    begin
+      if not wasMarked or not FCompositionActive then
+      begin
+        cancelCompositionEnd;
+        Inc(FCompositionGeneration);
+        FCompositionActive := True;
+        sendCompositionMessage(GTK_IM_FLAG_START or GTK_IM_FLAG_PREEDIT,
+          TCocoaStringUtil.getNSStringObject(aString));
+      end
+      else
+        sendCompositionMessage(GTK_IM_FLAG_PREEDIT or GTK_IM_FLAG_REPLACE,
+          TCocoaStringUtil.getNSStringObject(aString));
+    end
+    else if FCompositionActive then
+      queueCompositionEnd;
+  finally
+    release;
+  end;
+end;
+
+procedure TCocoaFieldEditor.unmarkText;
+var
+  wasMarked: Boolean;
+begin
+  retain;
+  try
+    wasMarked := NSTextInputClientProtocol(Self).hasMarkedText;
+    inherited unmarkText;
+    if not Assigned(lclGetCallback) then
+    begin
+      cancelCompositionEnd;
+      FCompositionActive := False;
+      Inc(FCompositionGeneration);
+    end
+    else if (wasMarked or FCompositionActive) and
+       not NSTextInputClientProtocol(Self).hasMarkedText then
+      queueCompositionEnd;
+  finally
+    release;
+  end;
+end;
+
+procedure TCocoaFieldEditor.finishCompositionEnd(
+  aToken: TCocoaTextViewCompositionEndToken);
+begin
+  if not Assigned(aToken) or (aToken <> FCompositionEndToken) then
+    Exit;
+  FCompositionEndToken := nil;
+  try
+    if FCompositionActive and
+       (aToken.generation = FCompositionGeneration) and
+       not NSTextInputClientProtocol(Self).hasMarkedText then
+      endComposition(nil, False);
+  finally
+    aToken.release;
+  end;
+end;
+
+procedure TCocoaFieldEditor.sendCompositionMessage(const flags: WPARAM;
+  const text: NSString);
+var
+  messageText: UTF8String;
+  messageData: LPARAM;
+begin
+  messageData := 0;
+  if Assigned(text) and (text.length > 0) then
+  begin
+    messageText := UTF8String(NSStringToString(text));
+    messageData := LPARAM(Pointer(PAnsiChar(messageText)));
+  end;
+  TCocoaLCLMessageUtil.deliverMessage(Self, LM_IM_COMPOSITION, flags,
+    messageData);
+end;
+
+procedure TCocoaFieldEditor.queueCompositionEnd;
+begin
+  if not FCompositionActive or Assigned(FCompositionEndToken) then
+    Exit;
+  FCompositionEndToken := TCocoaTextViewCompositionEndToken.alloc.init;
+  FCompositionEndToken.generation := FCompositionGeneration;
+  performSelector_withObject_afterDelay(
+    ObjCSelector('finishCompositionEnd:'), FCompositionEndToken, 0);
+end;
+
+procedure TCocoaFieldEditor.cancelCompositionEnd;
+begin
+  if not Assigned(FCompositionEndToken) then
+    Exit;
+  cancelPreviousPerformRequestsWithTarget_selector_object(
+    Self, ObjCSelector('finishCompositionEnd:'), FCompositionEndToken);
+  FCompositionEndToken.release;
+  FCompositionEndToken := nil;
+end;
+
+procedure TCocoaFieldEditor.endComposition(const committedText: NSString;
+  const isCommit: Boolean);
+var
+  flags: WPARAM;
+begin
+  if not FCompositionActive then
+    Exit;
+  cancelCompositionEnd;
+  FCompositionActive := False;
+  Inc(FCompositionGeneration);
+  flags := GTK_IM_FLAG_END;
+  if isCommit then
+    flags := flags or GTK_IM_FLAG_COMMIT;
+  sendCompositionMessage(flags, committedText);
+end;
+
 function TCocoaFieldEditor.becomeFirstResponder: LCLObjCBoolean;
 begin
   if goingReadOnly then Result := false
@@ -433,8 +597,15 @@ end;
 
 procedure TCocoaFieldEditor.setDelegate(adelegate: NSTextDelegateProtocol);
 begin
-  inherited setDelegate(adelegate);
-  lclReviseCursorColor;
+  retain;
+  try
+    if NSObject(delegate) <> NSObject(adelegate) then
+      endComposition(nil, False);
+    inherited setDelegate(adelegate);
+    lclReviseCursorColor;
+  finally
+    release;
+  end;
 end;
 
 procedure TCocoaFieldEditor.lclReviseCursorColor;
