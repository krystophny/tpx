# Pinned toolchain for the browser (WASI) build of TpX.
#
# Every value is overridable from the environment so that a developer or CI can
# point at their own checkout:  WASM_LCL=... make web
#
# The defaults are the locations used for the campaign that brought TpX to the
# browser; CI (see ci/web-toolchain.sh) recreates this layout from the pins.

# Lazarus fork carrying the experimental CustomDrawn/WASM widgetset.
WASM_LCL_URL=${WASM_LCL_URL:-https://github.com/krystophny/Lazarus.git}
WASM_LCL_REV=${WASM_LCL_REV:-feature/customdrawn-wasm-first-app}
WASM_LCL=${WASM_LCL:-$HOME/code/lazarus-lcl-wasm}

# FPC main branch, cross-built for wasm32-wasip1 (RTL + fcl packages + wasm-job).
WASM_FPC_URL=${WASM_FPC_URL:-https://gitlab.com/freepascal.org/fpc/source.git}
WASM_FPC_REV=${WASM_FPC_REV:-86125b587067db5bc22f5fa12426aacd7fd9d4e0}
WASM_FPC=${WASM_FPC:-$HOME/code/fpc-lcl-wasm}

# pas2js fork with the JOB object-release repair (upstream MR !103, unmerged).
WASM_PAS2JS_URL=${WASM_PAS2JS_URL:-https://github.com/krystophny/pas2js.git}
WASM_PAS2JS_REV=${WASM_PAS2JS_REV:-fix/job-release-object-id}
WASM_PAS2JS=${WASM_PAS2JS:-$HOME/code/pas2js-job-audit}

# Cross compiler and resource compiler built from the two trees above.
WASM_BIN=${WASM_BIN:-$HOME/code/fpc-lcl-wasm-toolchain/bin}
PPCWASM32=${PPCWASM32:-$WASM_BIN/ppcrosswasm32}
FPCRES=${FPCRES:-$WASM_BIN/fpcres}
PAS2JS=${PAS2JS:-$WASM_PAS2JS/bin/x86_64-linux/pas2js}
LAZRES=${LAZRES:-$(command -v lazres || echo /usr/lib/lazarus/tools/lazres)}

# Node bundler for the browser host.
ESBUILD=${ESBUILD:-$WASM_LCL/examples/customdrawnwasm/node_modules/.bin/esbuild}
